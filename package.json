{
  "name": "launcher-odal",
  "version": "1.1.55",
  "description": "Launcher Serveur Odal",
  "main": "main.js",
  "scripts": {
    "start": "powershell -Command \"$env:ELECTRON_RUN_AS_NODE=$null; node node_modules/electron/cli.js .\"",
    "test:update-gate": "node test-update-gate.js",
    "test:packaging": "node test-packaging.js",
    "build:win": "electron-builder --win nsis --x64",
    "build:mac": "electron-builder --mac dmg",
    "build": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "gg.odal.launcher",
    "productName": "Odal Launcher",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "updater-utils.js",
      "mod-platform.js",
      "distant-horizons-config.js",
      "skinview3d.bundle.js",
      "background.png",
      "mods-manifest.json",
      "mods-pack/**",
      "mods-pack-mac/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "mods-pack",
        "to": "mods-pack",
        "filter": [
          "islandfactionsgui-1.0.0.jar"
        ]
      },
      {
        "from": "mods-pack-mac",
        "to": "mods-pack-mac",
        "filter": [
          "islandfactionsgui-1.0.0.jar"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Odal Launcher"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": "icon.icns",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "minecraft-launcher-core": "^3.18.2",
    "minecraft-server-util": "^5.4.4",
    "msmc": "^4.1.0",
    "tar": "^7.5.19"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "electron-winstaller@5.4.0": true
  }
}
